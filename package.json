{
  "name": "break-ui-playwright",
  "private": true,
  "type": "module",
  "description": "Emil Kowalski's UI skills, tested with Playwright: a broken page and a fixed page for each skill, with the checks and screenshots to prove the difference.",
  "scripts": {
    "build": "esbuild app/toast.jsx --bundle --minify --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=app/dist/toast.js --log-level=warning",
    "start": "pnpm build && node server.mjs",
    "test": "playwright test; s=$?; node -e \"const fs=require('fs'),f='reports/index.html';if(fs.existsSync(f))fs.writeFileSync(f,fs.readFileSync(f,'utf8').split(process.cwd()+'/').join(''))\"; exit $s",
    "report": "open reports/index.html",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "22.19.17",
    "esbuild": "0.25.10",
    "executable-stories-formatters": "1.30.1",
    "executable-stories-playwright": "8.14.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sonner": "2.0.7",
    "typescript": "5.9.3"
  }
}
